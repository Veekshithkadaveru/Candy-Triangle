<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Keeps Android 12's mandatory starting window visually continuous with the Compose reveal. -->
    <style name="Theme.CandyTriangle.Splash" parent="Theme.CandyTriangle">
        <item name="android:windowSplashScreenBackground">@color/game_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/game_background</item>
        <item name="android:windowSplashScreenAnimationDuration">500</item>
    </style>

</resources>
