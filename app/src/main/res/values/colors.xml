<?xml version="1.0" encoding="utf-8"?>
<!--
    Candy Triangle palette.
    Source of truth for XML-side colours. The Compose side mirrors these in
    ui/theme/Color.kt. Board-entity tints that a designer may want to retune at
    runtime also live in assets/config.json (worlds[].pegTint, candies.colors[].hex).
-->
<resources>

    <!-- ============ Launcher icon (adaptive icon background) ============ -->
    <!-- Referenced by mipmap-anydpi-v26/ic_launcher*.xml (Agent B). Do not rename. -->
    <color name="ic_launcher_background">#320050</color>

    <!-- ============ World peg tints (PRD §6.1) ============ -->
    <color name="world_1_peg_tint">#FF4FC8</color>
    <color name="world_2_peg_tint">#3FE3FF</color>
    <color name="world_3_peg_tint">#A56BFF</color>
    <color name="world_4_peg_tint">#FFC23F</color>

    <!-- ============ Candy colours (PRD §4.1 — can_1..can_4) ============ -->
    <color name="candy_green">#3DE84B</color>
    <color name="candy_purple">#B23CF0</color>
    <color name="candy_pink">#FF4FC8</color>
    <color name="candy_blue">#33A0FF</color>

    <!-- ============ Gem colours (PRD §4.2) ============ -->
    <color name="gem_sweet">#B347E8</color>
    <color name="gem_blast">#FFA52B</color>
    <color name="gem_line">#14D8EB</color>
    <color name="gem_split">#FF4030</color>
    <color name="gem_extra_ball">#2BE05C</color>
    <color name="gem_magnet">#2E6BFF</color>
    <color name="gem_sugar_storm">#FF1F6B</color>

    <!-- ============ Board furniture ============ -->
    <color name="ball_default">#FF2EAF</color>
    <color name="crown_gold">#FFB01F</color>
    <color name="crown_empty_tint">#4A4358</color>
    <color name="cup_rim_gold">#FFC23F</color>
    <color name="board_frame_neon">#FF4FC8</color>
    <!-- 45% dark scrim applied over world backdrops on canvas (PRD §9.1). -->
    <color name="backdrop_scrim">#73000000</color>

    <!-- ============ Dark UI surfaces ============ -->
    <color name="game_background">#0B0518</color>
    <color name="surface_dark">#1A0B2E</color>
    <color name="surface_dark_high">#2A1148</color>
