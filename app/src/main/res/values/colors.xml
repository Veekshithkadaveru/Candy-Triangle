    <color name="status_success">#3DE84B</color>
    <color name="status_warning">#FFC23F</color>
    <color name="status_error">#FF6B6B</color>
    <color name="locked_gate">#5A4A70</color>

    <!-- ============ Neutrals ============ -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>

</resources>
